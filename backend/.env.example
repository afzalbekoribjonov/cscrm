# CSCRM API sozlamalari.
# Nusxa oling: cp .env.example .env  — keyin qiymatlarni to'ldiring.
# .env fayli git'ga TUSHMAYDI.

NODE_ENV=development
PORT=8080

# Admin websayt manzillari (vergul bilan).
CORS_ORIGINS=http://localhost:5173,https://cscrm.uz

# --- Firebase Admin SDK ---
# Firebase Console → Project settings → Service accounts →
# "Generate new private key" → yuklab olingan JSON.
#
# Tavsiya: JSON'ni base64 ga o'rab bitta qatorga aylantiring —
#   Linux/macOS: base64 -w0 serviceAccountKey.json
#   PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))
FIREBASE_SERVICE_ACCOUNT=

FIREBASE_DATABASE_URL=https://cscrm-xxxxx-default-rtdb.europe-west1.firebasedatabase.app

# --- Litsenziya imzosi ---
# Kamida 32 bayt tasodifiy maxfiy kalit. Yaratish:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# DIQQAT: bu kalit o'zgarsa, barcha qurilmalardagi keshlangan litsenziya
# javoblari yaroqsiz bo'ladi (ilova qayta so'raydi — xavfli emas, lekin
# bir martalik yuk beradi).
LICENSE_SIGNING_SECRET=

# --- Super-admin ---
# CSCRM egasi(lari)ning Firebase UID'lari, vergul bilan.
SUPER_ADMIN_UIDS=

# --- To'lov ma'lumotlari ---
# Ilovadagi to'lov ekranida ko'rsatiladi. Kodda emas, shu yerda turadi -
# karta almashsa ilovani qayta yig'ish shart emas.
# Kartalar vergul bilan. Turi (Humo/Uzcard) raqamdan aniqlanadi.
PAYMENT_CARDS=9860 0000 0000 0000, 8600 0000 0000 0000
PAYMENT_CARD_HOLDER=FAMILIYA ISM
PAYMENT_PHONE=+998 90 000 00 00
PAYMENT_EMAIL=support@cscrm.uz
PAYMENT_TELEGRAM=https://t.me/cscrm_support
