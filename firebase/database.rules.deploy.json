{
  "rules": {
    ".read": false,
    ".write": false,
    "super_admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "admin_logins": {
      ".indexOn": [
        "tenantId"
      ],
      "$login": {
        ".read": false,
        ".write": false
      }
    },
    "employee_phone_index": {
      ".read": false,
      ".write": false
    },
    "employee_secrets": {
      ".read": false,
      ".write": false
    },
    "user_tenants": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "tenant_directory": {
      ".read": false,
      ".write": false
    },
    "pending_payments": {
      ".read": false,
      ".write": false,
      ".indexOn": [
        "tenantId"
      ]
    },
    "broadcasts": {
      ".read": false,
      ".write": false,
      ".indexOn": [
        "createdAt"
      ]
    },
    "push_tokens": {
      ".read": false,
      ".write": false,
      ".indexOn": [
        "tenantId"
      ]
    },
    "tenant_archive": {
      ".read": false,
      ".write": false
    },
    "admin_audit": {
      ".read": false,
      ".write": false,
      ".indexOn": [
        "at",
        "tenantId"
      ]
    },
    "admin_roles": {
      ".read": false,
      ".write": false
    },
    "admin_members": {
      ".read": false,
      ".write": false
    },
    "plan_prices": {
      ".read": false,
      ".write": false
    },
    "site_settings": {
      ".read": false,
      ".write": false
    },
    "payments_log": {
      ".read": false,
      ".write": false,
      ".indexOn": [
        "at"
      ]
    },
    "tenants": {
      "$tenantId": {
        "profile": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          ".write": false
        },
        "license": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          ".write": false
        },
        "members": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          ".write": false
        },
        "employees": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          ".write": "auth != null && auth.token.tenantId === $tenantId && auth.token.role === 'owner' && root.child('tenants').child($tenantId).child('license').child('suspended').val() !== true",
          ".indexOn": [
            "phone",
            "active"
          ],
          "$employeeId": {
            ".read": "auth != null && auth.token.tenantId === $tenantId && auth.token.employeeId === $employeeId"
          }
        },
        "products": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          ".write": "auth != null && auth.token.tenantId === $tenantId && auth.token.role === 'owner' && root.child('tenants').child($tenantId).child('license').child('suspended').val() !== true"
        },
        "counters": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          "$counter": {
            ".write": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false)) && root.child('tenants').child($tenantId).child('license').child('suspended').val() !== true && newData.exists()",
            ".validate": "newData.isNumber() && (!data.exists() || !data.isNumber() || newData.val() > data.val())"
          }
        },
        "orders": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          ".indexOn": [
            "active",
            "status",
            "createdAt",
            "deliveredAt",
            "createdBy",
            "debtAmount",
            "customerPhone"
          ],
          "$orderId": {
            ".write": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false)) && root.child('tenants').child($tenantId).child('license').child('suspended').val() !== true"
          }
        },
        "settings": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          ".write": "auth != null && auth.token.tenantId === $tenantId && auth.token.role === 'owner' && root.child('tenants').child($tenantId).child('license').child('suspended').val() !== true",
          "policies": {
            ".validate": "newData.hasChildren()",
            "deadlineDays": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30"
            },
            "warehouseDays": {
              ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 90"
            },
            "deadlineRequired": {
              ".validate": "newData.isBoolean()"
            },
            "addressRequired": {
              ".validate": "newData.isBoolean()"
            },
            "pickupGpsRequired": {
              ".validate": "newData.isBoolean()"
            },
            "debtAllowed": {
              ".validate": "newData.isBoolean()"
            },
            "measureBeforeWash": {
              ".validate": "newData.isBoolean()"
            },
            "measureBeforePackaging": {
              ".validate": "newData.isBoolean()"
            },
            "rewashReasonRequired": {
              ".validate": "newData.isBoolean()"
            },
            "partialHandoverEnabled": {
              ".validate": "newData.isBoolean()"
            },
            "warehouseEnabled": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "expenses": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          ".indexOn": [
            "spentAt"
          ],
          "$expenseId": {
            ".write": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false)) && root.child('tenants').child($tenantId).child('license').child('suspended').val() !== true"
          }
        },
        "order_history": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          ".indexOn": [
            "orderId",
            "at"
          ],
          "$entryId": {
            ".write": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false)) && root.child('tenants').child($tenantId).child('license').child('suspended').val() !== true && !data.exists()"
          }
        },
        "payments": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          ".write": false
        },
        "payment_requests": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          ".write": false
        },
        "payroll_rates": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          ".write": "auth != null && auth.token.tenantId === $tenantId && auth.token.role === 'owner' && root.child('tenants').child($tenantId).child('license').child('suspended').val() !== true",
          ".validate": "newData.hasChildren()",
          "products": {
            "$productId": {
              "wash": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
              },
              "pack": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
              },
              "washSmall": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
              },
              "washLarge": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
              },
              "packSmall": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
              },
              "packLarge": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "courierPct": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
          },
          "dispatcherMode": {
            ".validate": "newData.val() === 'percent' || newData.val() === 'fixed'"
          },
          "dispatcherValue": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "payroll_staff": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && auth.token.role === 'owner'",
          "$employeeId": {
            ".write": "auth != null && auth.token.tenantId === $tenantId && auth.token.role === 'owner' && root.child('tenants').child($tenantId).child('license').child('suspended').val() !== true",
            ".validate": "newData.hasChildren(['type'])",
            "type": {
              ".validate": "newData.val() === 'piece' || newData.val() === 'fixed' || newData.val() === 'mixed'"
            },
            "monthly": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
            },
            "pieces": {
              "$kind": {
                ".validate": "newData.isBoolean() && ($kind === 'wash' || $kind === 'pack' || $kind === 'courier' || $kind === 'dispatch')"
              }
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "payroll_payments": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && auth.token.role === 'owner'",
          ".indexOn": [
            "month"
          ],
          "$paymentId": {
            ".write": "auth != null && auth.token.tenantId === $tenantId && auth.token.role === 'owner' && root.child('tenants').child($tenantId).child('license').child('suspended').val() !== true",
            ".validate": "newData.hasChildren(['employeeId', 'amount', 'kind', 'month', 'at'])",
            "employeeId": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
            },
            "amount": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1000000000"
            },
            "kind": {
              ".validate": "newData.val() === 'advance' || newData.val() === 'salary'"
            },
            "month": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}$/)"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "note": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "byName": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "work_days": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && auth.token.role === 'owner'",
          "$day": {
            "$employeeId": {
              ".write": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false)) && root.child('tenants').child($tenantId).child('license').child('suspended').val() !== true && $day.matches(/^[0-9]{8}$/)",
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 120"
              },
              "wash": {
                "$unit": {
                  ".validate": "newData.isNumber() && ($unit === 'm2' || $unit === 'metr' || $unit === 'kg' || $unit === 'dona' || $unit === 'kichik' || $unit === 'katta')"
                }
              },
              "pack": {
                "$unit": {
                  ".validate": "newData.isNumber() && ($unit === 'm2' || $unit === 'metr' || $unit === 'kg' || $unit === 'dona' || $unit === 'kichik' || $unit === 'katta')"
                }
              },
              "washN": {
                ".validate": "newData.isNumber()"
              },
              "washPay": {
                ".validate": "newData.isNumber()"
              },
              "packN": {
                ".validate": "newData.isNumber()"
              },
              "packPay": {
                ".validate": "newData.isNumber()"
              },
              "deliverN": {
                ".validate": "newData.isNumber()"
              },
              "deliverSum": {
                ".validate": "newData.isNumber()"
              },
              "deliverPay": {
                ".validate": "newData.isNumber()"
              },
              "createN": {
                ".validate": "newData.isNumber()"
              },
              "createPay": {
                ".validate": "newData.isNumber()"
              },
              "dispatchN": {
                ".validate": "newData.isNumber()"
              },
              "dispatchSum": {
                ".validate": "newData.isNumber()"
              },
              "dispatchPay": {
                ".validate": "newData.isNumber()"
              },
              "rewashN": {
                ".validate": "newData.isNumber()"
              },
              "rewashPay": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "warnings": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && auth.token.role === 'owner'",
          "$employeeId": {
            ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false)) && auth.token.employeeId === $employeeId",
            ".indexOn": [
              "at"
            ],
            "$warningId": {
              ".write": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false)) && root.child('tenants').child($tenantId).child('license').child('suspended').val() !== true && (!data.exists() || auth != null && auth.token.tenantId === $tenantId && auth.token.role === 'owner')",
              ".validate": "newData.hasChildren(['at', 'orderId', 'byName'])",
              "at": {
                ".validate": "newData.isNumber()"
              },
              "orderId": {
                ".validate": "newData.isNumber()"
              },
              "itemKey": {
                ".validate": "newData.isString() && newData.val().length <= 32"
              },
              "productName": {
                ".validate": "newData.isString() && newData.val().length <= 200"
              },
              "reason": {
                ".validate": "newData.isString() && newData.val().length <= 500"
              },
              "byId": {
                ".validate": "newData.isString() && newData.val().length <= 128"
              },
              "byName": {
                ".validate": "newData.isString() && newData.val().length <= 120"
              },
              "deduction": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "seenAt": {
                ".write": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false)) && root.child('tenants').child($tenantId).child('license').child('suspended').val() !== true && auth.token.employeeId === $employeeId && data.parent().exists()",
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
