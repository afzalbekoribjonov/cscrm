{
  "//": [
    "CSCRM Realtime Database xavfsizlik qoidalari — KO'P IJARACHILI.",
    "MANBA: firebase/rules.mjs — bu faylni qo'lda tahrirlamang.",
    "",
    "ASOSIY G'OYA: har bir biznes = bitta `tenant`. Foydalanuvchi FAQAT o'z",
    "tenant'ining ma'lumotini ko'radi (`auth.token.tenantId` — uni faqat",
    "backend (Admin SDK) qo'ya oladi).",
    "",
    "A'ZO = ega YOKI mavjud va bloklanmagan xodim. Token da'vosining o'zi",
    "yetarli emas: o'chirilgan xodimning telefonidagi token yangilanishda",
    "davom etadi. `active !== false` — eski yozuvlarda maydon bo'lmasligi mumkin.",
    "",
    "MEROS QOIDASI: ota tugunda berilgan ruxsat bolalarga o'tadi va bola",
    "darajasida BEKOR QILIB BO'LMAYDI. Shu sababli yozish ruxsati ro'yxat",
    "tugunida emas, har bir YOZUV darajasida (`$orderId` va h.k.) beriladi.",
    "",
    "TO'XTATILGAN BIZNES (`license/suspended`) o'qiy oladi, yoza olmaydi.",
    "Muddat tugashi bu yerda ATAYLAB tekshirilmaydi — uni server imzolagan",
    "javob orqali ilova hal qiladi."
  ],
  "rules": {
    ".read": false,
    ".write": false,
    "super_admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "admin_logins": {
      ".indexOn": [
        "tenantId"
      ],
      "$login": {
        ".read": false,
        ".write": false
      }
    },
    "employee_phone_index": {
      "//": "Telefon -> tenant xaritasi. Ochiq bo'lsa, barcha xodim raqamlarini yig'ib olish mumkin bo'lardi.",
      ".read": false,
      ".write": false
    },
    "employee_secrets": {
      "//": "Xodimlarning PIN hashlari. Avval xodim yozuvi ichida `.read: false` bilan turardi — lekin ota `employees` ochiq bo'lgani uchun bu ishlamasdi (meros qoidasi). Endi alohida, mijozga butunlay berk tugunda.",
      ".read": false,
      ".write": false
    },
    "user_tenants": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "tenant_directory": {
      "//": "Bizneslar ID'lari — super-admin paneli uchun.",
      ".read": false,
      ".write": false
    },
    "pending_payments": {
      "//": "Ko'rib chiqilmagan to'lov so'rovlari navbati.",
      ".read": false,
      ".write": false,
      ".indexOn": [
        "tenantId"
      ]
    },
    "broadcasts": {
      "//": "CSCRM xabarlari. Ilova ularni `/license/messages` orqali oladi — u yerda ichki maydonlar (yuborgan admin UID'i) olib tashlanadi. Ilova bu tugunni hech qachon to'g'ridan-to'g'ri o'qimagan.",
      ".read": false,
      ".write": false,
      ".indexOn": [
        "createdAt"
      ]
    },
    "push_tokens": {
      "//": "Qurilma FCM tokenlari.",
      ".read": false,
      ".write": false,
      ".indexOn": [
        "tenantId"
      ]
    },
    "tenant_archive": {
      "//": "Arxivdagi bizneslar: qachon, kim, nega, qachon o'chiriladi. Mijozga BUTUNLAY berk — arxivlangan biznes buni 'to'xtatilgan' holat orqali ko'radi.",
      ".read": false,
      ".write": false
    },
    "admin_audit": {
      "//": "Admin amallari jurnali (kim, nima, qachon). Mijozga BUTUNLAY berk; parol va tokenlar bu yerga hech qachon yozilmaydi.",
      ".read": false,
      ".write": false,
      ".indexOn": [
        "at",
        "tenantId"
      ]
    },
    "admin_roles": {
      "//": "Panel rollari va ularning vakolatlari. Faqat server o'qiydi va yozadi — mijoz o'ziga rol bera olmasligi kerak.",
      ".read": false,
      ".write": false
    },
    "admin_members": {
      "//": "Panel xodimlari (uid → rol). Faqat server.",
      ".read": false,
      ".write": false
    },
    "plan_prices": {
      "//": "Reja narxlari. Ilova ularni `/license/plans` orqali oladi.",
      ".read": false,
      ".write": false
    },
    "site_settings": {
      "//": "Websayt sozlamalari.",
      ".read": false,
      ".write": false
    },
    "payments_log": {
      "//": "Tasdiqlangan to'lovlar — daromad statistikasi.",
      ".read": false,
      ".write": false,
      ".indexOn": [
        "at"
      ]
    },
    "tenants": {
      "$tenantId": {
        "profile": {
          "//": "Mijoz YOZA OLMAYDI. `ownerUid` ni mijoz o'zgartira olishi hisobni egallash zanjiriga yo'l ochardi. Ilova profilga hech qachon yozmagan; tahrirlash backend orqali.",
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          ".write": false
        },
        "license": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          ".write": false
        },
        "members": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          ".write": false
        },
        "employees": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          ".write": "auth != null && auth.token.tenantId === $tenantId && auth.token.role === 'owner' && root.child('tenants').child($tenantId).child('license').child('suspended').val() !== true",
          ".indexOn": [
            "phone",
            "active"
          ],
          "$employeeId": {
            "//": "Xodim O'Z yozuvini bloklangan bo'lsa ham o'qiy oladi: ilova shu yozuvni kuzatib, `active: false` ni ko'rgach xodimni toza chiqarib yuboradi.",
            ".read": "auth != null && auth.token.tenantId === $tenantId && auth.token.employeeId === $employeeId"
          }
        },
        "products": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          ".write": "auth != null && auth.token.tenantId === $tenantId && auth.token.role === 'owner' && root.child('tenants').child($tenantId).child('license').child('suspended').val() !== true"
        },
        "counters": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          "$counter": {
            "//": "Faqat O'SADI va o'chirilmaydi — aks holda keyingi buyurtma mavjud buyurtma raqamini olib, uning ustidan yozilardi. `!data.isNumber()` — eski matnli qiymatni ilova o'zi tuzatadi.",
            ".write": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false)) && root.child('tenants').child($tenantId).child('license').child('suspended').val() !== true && newData.exists()",
            ".validate": "newData.isNumber() && (!data.exists() || !data.isNumber() || newData.val() > data.val())"
          }
        },
        "orders": {
          "//": "Yozish har bir BUYURTMA darajasida: butun ro'yxatni bitta so'rov bilan o'chirib bo'lmaydi.",
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          ".indexOn": [
            "active",
            "status",
            "createdAt",
            "deliveredAt",
            "createdBy",
            "debtAmount"
          ],
          "$orderId": {
            ".write": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false)) && root.child('tenants').child($tenantId).child('license').child('suspended').val() !== true"
          }
        },
        "expenses": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          ".indexOn": [
            "spentAt"
          ],
          "$expenseId": {
            ".write": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false)) && root.child('tenants').child($tenantId).child('license').child('suspended').val() !== true"
          }
        },
        "order_history": {
          "//": "O'zgarishlar jurnali — FAQAT QO'SHILADI. Mavjud yozuvni o'zgartirib yoki o'chirib bo'lmaydi. Ilova har doim yangi (push) kalitga yozadi.",
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          ".indexOn": [
            "orderId",
            "at"
          ],
          "$entryId": {
            ".write": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false)) && root.child('tenants').child($tenantId).child('license').child('suspended').val() !== true && !data.exists()"
          }
        },
        "payments": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          ".write": false
        },
        "payment_requests": {
          ".read": "auth != null && auth.token.tenantId === $tenantId && (auth.token.role === 'owner' || (root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).exists() && root.child('tenants').child($tenantId).child('employees').child(auth.token.employeeId).child('active').val() !== false))",
          ".write": false
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
