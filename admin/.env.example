# CSCRM websayt sozlamalari. Nusxa oling: cp .env.example .env.local
# Vite faqat `VITE_` bilan boshlanadigan o'zgaruvchilarni brauzerga uzatadi.
#
# DIQQAT: bu yerdagi qiymatlar BRAUZERGA CHIQADI — maxfiy kalit yozmang.
# Firebase web apiKey maxfiy emas (u faqat loyihani aniqlaydi); haqiqiy
# himoya Realtime Database qoidalari va backend tomonida.

VITE_API_BASE_URL=http://localhost:8080

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=cscrm-xxxxx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cscrm-xxxxx
VITE_FIREBASE_DATABASE_URL=https://cscrm-xxxxx-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
